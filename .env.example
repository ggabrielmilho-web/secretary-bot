# Telegram (true = ativo, false = desativado)
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=seu_token_do_botfather

# OpenAI
OPENAI_API_KEY=sua_chave_openai

# Banco de Dados
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/secretary_bot

# Diretores autorizados no Telegram (IDs separados por vírgula)
AUTHORIZED_USERS=123456789,987654321

# Google Calendar (Domain-Wide Delegation)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json

# Mapeamento Telegram ID → Email Google Workspace
USER_EMAIL_MAP=123456789:diretor1@empresa.com.br,987654321:diretor2@empresa.com.br

# Timezone
TIMEZONE=America/Sao_Paulo

# WhatsApp via UazAPI
UAZAPI_TOKEN=seu_token_uazapi
UAZAPI_BASE_URL=https://carvalhoia.uazapi.com
WEBHOOK_PORT=8080
AUTHORIZED_WHATSAPP=5534999999999,5534888888888
WHATSAPP_EMAIL_MAP=5534999999999:diretor1@empresa.com.br,5534888888888:diretor2@empresa.com.br
